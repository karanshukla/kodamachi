{
  "lexicon": 1,
  "id": "app.kodamachi.inbox.question",
  "description": "An anonymous question in a recipient's inbox space. The recipient is implied by the space.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["message", "createdAt"],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
