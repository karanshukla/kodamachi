{
  "name": "kodamachi-server",
  "version": "1.0.0",
  "description": "For answering anonymous questions and posting them to Bluesky",
  "author": "Karan Shukla",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch --no-clear-screen src/index.ts | bunx --bun pino-pretty",
    "start": "bun src/index.ts",
    "lexgen": "bunx --bun lex gen-server ./src/lexicon ./lexicons/*",
    "clean": "rm -rf coverage",
    "lint": "bunx --bun oxlint .",
    "lint:fix": "bunx --bun oxlint . --fix",
    "typecheck": "bun check",
    "test": "bun test --isolate --no-env-file --preload ./src/tests/test-bootstrap.js src/tests/",
    "test:watch": "bun test --isolate --no-env-file --watch --preload ./src/tests/test-bootstrap.js src/tests/",
    "test:coverage": "bun test --isolate --no-env-file --coverage --preload ./src/tests/test-bootstrap.js src/tests/",
    "publish-lexicons": "bun src/scripts/publish-lexicons.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "bun fmt",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@atproto/api": "^0.28.1",
    "@atproto/common": "^0.8.6",
    "@atproto/identity": "^0.5.20",
    "@atproto/lexicon": "^0.7.17",
    "@atproto/oauth-client-node": "^0.5.12",
    "@atproto/syntax": "^0.7.7",
    "@atproto/xrpc-server": "^0.13.6",
    "@aturi.to/waypoints": "0.1.4",
    "@axiomhq/pino": "^2.0.0",
    "@hono/zod-validator": "^0.9.1",
    "@types/cryptr": "^4.0.3",
    "@types/web-push": "^3.6.4",
    "cryptr": "^6.4.0",
    "dotenv": "^18.0.9",
    "envalid": "^8.2.0",
    "hono": "^4.13.14",
    "hono-rate-limiter": "^0.5.4",
    "kysely": "^0.29.7",
    "multiformats": "^14.0.5",
    "obscenity": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "uhtml": "^5.0.9",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.10.16",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
