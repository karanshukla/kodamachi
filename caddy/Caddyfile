# Routing, retry budgets, headers and cache policy are documented in README.md.
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

(lb_settings) {
	lb_policy round_robin
	lb_retries 100
	lb_try_duration 10s
	lb_try_interval 250ms
}

(waf_lb_settings) {
	lb_policy round_robin
	lb_retries 2
	lb_try_duration 3s
	lb_try_interval 250ms
}

(passive_health_checks) {
	fail_duration 60s
	max_fails 300
	unhealthy_latency 5s
	unhealthy_request_count 200
}

(backend_proxy) {
	import lb_settings
	import passive_health_checks
	header_up Host {upstream_hostport}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Host {host}
}

:{$PORT} {
	log {
		format json
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@non_assets {
		not path /assets/*
		not path /api/*
		not path /og-cache/*
	}
	header @non_assets Cache-Control "no-cache, no-store, must-revalidate"

	handle_path {$BACKEND_PATH:/api}/* {
		@us_user header Cookie *nf-region=us*

		handle @us_user {
			log_append backend_region "na"
			header X-Backend-Region "na"
			reverse_proxy {
				dynamic a {
					name {$BACKEND_NA_DOMAIN}
					port {$BACKEND_NA_PORT:3000}
					refresh 1s
					dial_timeout 30s
					versions ipv4 ipv6
				}
				import backend_proxy
			}
		}

		handle {
			log_append backend_region "eu"
			header X-Backend-Region "eu"
			reverse_proxy {
				dynamic a {
					name {$BACKEND_EU_DOMAIN}
					port {$BACKEND_EU_PORT:3000}
					refresh 1s
					dial_timeout 30s
					versions ipv4 ipv6
				}
				import backend_proxy
			}
		}
	}

	reverse_proxy {
		dynamic a {
			name {$FRONTEND_DOMAIN}
			port {$FRONTEND_PORT}
			refresh 1s
			dial_timeout 30s
			versions ipv4 ipv6
		}

		import waf_lb_settings
		import passive_health_checks

		header_up Host {upstream_hostport}
	}
}
