{
  "bots": [
    {
      "name": "probe-dotenv",
      "path_regex": "(^|/)\\.env([./~-]|$)",
      "action": "DENY"
    },
    {
      "name": "probe-path-traversal",
      "path_regex": "\\.\\.|(^|/)@(fs|vite)(/|$)|(^|/)proc/(self|[0-9]+)/",
      "action": "DENY"
    },
    {
      "name": "probe-vcs-and-cms",
      "path_regex": "(^|/)\\.git(/|$)|(^|/)wp/|(^|/)(wp-admin|wp-content|wp-includes|wlwmanifest\\.xml)(/|$)",
      "action": "DENY"
    },
    {
      "name": "probe-credentials",
      "path_regex": "(^|/)\\.(aws|ssh|anthropic|openai|azure|gcloud|oci|docker|kube|config|htpasswd|netrc|npmrc)(/|$)|(^|/)(id_rsa|id_dsa|id_ecdsa|id_ed25519|private-key|credentials|secrets)(\\.[a-z0-9]+)?$|\\.(php|pem|key|p12|pfx|keystore|sql|bak|old|swp|ini|conf|ya?ml|db)$",
      "action": "DENY"
    },
    {
      "name": "static-assets",
      "path_regex": "^/(assets/.*|[^/]+\\.(css|ico|js|json|mjs|png|svg|txt|webmanifest|webp|woff|woff2|xml))$",
      "action": "ALLOW"
    },
    {
      "name": "app-shell",
      "path_regex": "^/index\\.html$",
      "action": "ALLOW"
    },
    {
      "name": "cardybot-bluesky",
      "user_agent_regex": "Bluesky Cardyb",
      "action": "ALLOW"
    },
    {
      "import": "(data)/meta/default-config.yaml"
    },
    {
      "name": "generic-browser",
      "user_agent_regex": "Mozilla",
      "action": "CHALLENGE"
    }
  ],
  "dnsbl": false,
  "store": {
    "backend": "valkey",
    "parameters": {
      "url": "redis://valkey.railway.internal:6379/0"
    }
  },
  "status_codes": {
    "CHALLENGE": 200,
    "DENY": 200
  },
  "openGraph": {
    "enabled": true,
    "considerHost": false,
    "ttl": "24h"
  },
  "impressum": {
    "footer": "kodamachi is an open-source, AT Protocol-native anonymous Q&A app for Bluesky. This check runs once per browser to keep automated scrapers off the public inbox pages; it stores a single cookie and nothing else.",
    "page": {
      "title": "About this check",
      "body": "<p>kodamachi uses <a href=\"https://anubis.techaro.lol\">Anubis</a> to filter automated traffic before it reaches the app. The proof-of-work check runs once per browser, sets a single cookie so it is not repeated, and processes only the connection metadata needed to serve the page.</p><p>kodamachi itself never sees the identity of anyone who sends an anonymous question. Source, licence and issue tracker: <a href=\"https://github.com/karanshukla/navyfragen-app\">github.com/karanshukla/navyfragen-app</a>.</p>"
    }
  }
}
