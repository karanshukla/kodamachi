FROM oven/bun:1.4-alpine AS builder
WORKDIR /app

# patches/ is needed for patchedDependencies; every workspace manifest must be
# copied or bun install fails on the root workspaces array.
COPY package.json bun.lock ./
COPY patches/ ./patches/
COPY server/package.json ./server/
COPY client/package.json ./client/
COPY html-to-image/package.json ./html-to-image/

# --omit dev (not --production) keeps workspace prod deps.
RUN bun install --frozen-lockfile --omit dev

# Bun's isolated layout symlinks workspace deps into /app/node_modules/.bun; keep it.
FROM oven/bun:1.4-alpine
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server/node_modules ./server/node_modules
COPY brand.json ./
COPY server/package.json server/tsconfig.json ./server/
COPY server/src ./server/src
COPY server/lexicons ./server/lexicons

WORKDIR /app/server
EXPOSE 3000

CMD ["bun", "src/index.ts"]
