FROM oven/bun:1.4-alpine AS builder
WORKDIR /app

# System Chromium via PUPPETEER_EXECUTABLE_PATH. tini is PID 1: Bun doesn't reap
# orphaned Chromium children, so browser churn would leak zombies.
RUN apk add --no-cache \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ca-certificates \
      ttf-freefont \
      font-noto-emoji \
      tini

COPY package.json bun.lock ./
COPY patches/ ./patches/
COPY client/package.json ./client/
COPY server/package.json ./server/
COPY html-to-image/package.json ./html-to-image/

# --omit dev (not --production) keeps workspace prod deps. The bundled Chromium
# download is skipped; the system one runs.
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
RUN bun install --frozen-lockfile --omit dev

FROM oven/bun:1.4-alpine
WORKDIR /app

RUN apk add --no-cache \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ca-certificates \
      ttf-freefont \
      font-noto-emoji \
      tini \
      && rm -rf /var/cache/apk/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/html-to-image/node_modules ./html-to-image/node_modules
COPY html-to-image/app.js ./html-to-image/app.js
COPY html-to-image/package.json ./html-to-image/package.json

WORKDIR /app/html-to-image
EXPOSE 3033

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["bun", "app.js"]
