# Copy to .env. Generate secrets with: openssl rand -hex 32

# ── Required ──────────────────────────────────────────────────────────────────

# AES-256 key for OAuth tokens
OAUTH_TOKEN_SECRET=

# Session cookie signing secret
COOKIE_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Leave PUBLIC_URL unset for local dev: the server uses the loopback OAuth client
# (RFC 8252) and port 3000 must reach your browser. Set it only for a real https://
# URL (e.g. a tunnel for OG previews from an external crawler); http://localhost
# fails client metadata validation.
# PUBLIC_URL=https://your-tunnel-subdomain.ngrok-free.app

# POSTGRES_USER=navyfragen
# POSTGRES_PASSWORD=navyfragen
# POSTGRES_DB=navyfragen

# ── E2E Testing (never set these in production) ───────────────────────────────
# Only for the docker-compose.e2e.yml overlay; see docs/e2e-testing.md. Playwright reads this file.
# E2E_PDS_URL=https://bsky.social
# E2E_HANDLE=yourhandle.bsky.social
# E2E_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
