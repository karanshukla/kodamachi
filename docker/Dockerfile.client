FROM oven/bun:1.4-alpine
WORKDIR /app

# patches/ is needed for patchedDependencies; every workspace manifest must be
# copied or bun install fails on the root workspaces array.
COPY package.json bun.lock brand.json ./
COPY patches/ ./patches/
COPY client/package.json ./client/
COPY server/package.json ./server/
COPY html-to-image/package.json ./html-to-image/

RUN bun install --frozen-lockfile --ignore-scripts

COPY client/ ./client/

ARG VITE_API_URL=/api
ARG VITE_SHORTLINK_URL
ARG VITE_E2E_TESTING=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SHORTLINK_URL=$VITE_SHORTLINK_URL
ENV VITE_E2E_TESTING=$VITE_E2E_TESTING

RUN bun run --cwd client build

EXPOSE 3000

WORKDIR /app/client
CMD ["bun", "run", "start"]
