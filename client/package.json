{
  "name": "kodamachi-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host",
    "build": "bun check && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "start": "bun serve.ts",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "typecheck": "bun check && bun check -p tsconfig.test.json",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "test:coverage": "bunx --bun vitest run --coverage",
    "check:i18n": "bun ../scripts/check-i18n.mjs",
    "check:locale-chunking": "bun scripts/check-locale-chunking.mjs",
    "probe:bun": "bun --bun probe-bun-vite.mjs",
    "render:brand-assets": "bun scripts/render-brand-assets.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "bun fmt",
      "bun lint --fix"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "happy-dom": "^20.14.6",
    "msw": "^2.15.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@atcute/bluesky-richtext-parser": "^2.1.2",
    "@aturi.to/waypoints-react": "^0.1.4",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@tabler/icons": "^3.49.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "use-haptic": "^1.1.13",
    "zod": "^4.6.6"
  }
}
